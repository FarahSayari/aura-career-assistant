# Optional: Aura works without a .env file or API credentials.
AURA_APP_NAME="Aura 2.0 — Agentic AI Career Assistant"
AURA_APP_ENV=development
AURA_PDF_MAX_SIZE_MB=10

# Required only after explicitly choosing Gemini analysis; leave blank for local extraction.
# Never put a real API key in this example file.
AURA_GEMINI_API_KEY=
# Choose a stable model enabled for your Gemini API project. No automatic model fallback.
AURA_GEMINI_MODEL=gemini-2.5-flash

# P1.1 agent candidate (separate from the existing structured CV extractor).
# Model access/quality must be checked in your project; no automatic fallback.
AURA_AGENT_MODEL=gemini-3.5-flash-lite
AURA_AGENT_MAX_MODEL_CALLS=6
AURA_AGENT_MAX_TURNS=10
